# -----------------------------------------------------------------------
# Archivo de variables de entorno - EJEMPLO
# Copia este archivo como ".env" (sin .example) y completa tus valores reales.
# El archivo ".env" real NUNCA debe subirse al repositorio (ver .gitignore).
# -----------------------------------------------------------------------

# Seguridad de Django
SECRET_KEY=django-insecure-cambia-esta-clave-por-una-generada-para-produccion
DEBUG=True

# Hosts permitidos (separados por coma). Ejemplo producción: midominio.cl,www.midominio.cl
ALLOWED_HOSTS=127.0.0.1,localhost

# -----------------------------------------------------------------------
# Base de datos MySQL / MariaDB (visible luego en phpMyAdmin)
# -----------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=sitio_informativo_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
