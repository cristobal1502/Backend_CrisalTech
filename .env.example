# -----------------------------------------------------------------------
# Archivo de variables de entorno - EJEMPLO
# Copia este archivo como ".env" (sin .example) y completa tus valores reales.
# El archivo ".env" real NUNCA debe subirse al repositorio (ver .gitignore).
# -----------------------------------------------------------------------

# Seguridad de Django
SECRET_KEY=django-insecure-cambia-esta-clave-por-una-generada-para-produccion
DEBUG=True

# Hosts permitidos (separados por coma). Incluye la IP pública de la instancia en la nube.
ALLOWED_HOSTS=3.94.106.128,localhost,127.0.0.1

# -----------------------------------------------------------------------
# Base de datos MySQL / MariaDB en la instancia de la nube (visible en phpMyAdmin)
# -----------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=sitio_informativo_db
DB_USER=
DB_PASSWORD=
DB_HOST=3.94.106.128
DB_PORT=3306
